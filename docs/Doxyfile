# Doxyfile for Aurora Signal Chain
# Doxygen configuration

#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

PROJECT_NAME           = "Aurora Signal Chain"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Coherent LiDAR Simulation Framework"
OUTPUT_DIRECTORY       = docs/api

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

#---------------------------------------------------------------------------
# Input configuration
#---------------------------------------------------------------------------

INPUT                  = forward/include \
                         acquisition/include \
                         simulation/include \
                         dsp/include \
                         docs/examples
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp
EXCLUDE_PATTERNS       = */test/*
EXAMPLE_PATH           = docs/examples
EXAMPLE_PATTERNS       = *.cpp

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# HTML output configuration
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

#---------------------------------------------------------------------------
# Other output formats
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = forward/include \
                         acquisition/include \
                         simulation/include \
                         dsp/include

#---------------------------------------------------------------------------
# External references
#---------------------------------------------------------------------------

TAGFILES               =
GENERATE_TAGFILE       =

#---------------------------------------------------------------------------
# Dot tool configuration
#---------------------------------------------------------------------------

HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
DOT_TRANSPARENT        = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

#---------------------------------------------------------------------------
# LaTeX formulas (for mathematical documentation)
#---------------------------------------------------------------------------

USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
